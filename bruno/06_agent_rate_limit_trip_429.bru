meta {
  name: 06 Agent Rate Limit Trip 429
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/agent/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  CF-Connecting-IP: {{isolatedTestIp}}
}

body:json {
  {
    "query": "Summarize Shreyas Viswam.ai Tech Lead experience",
    "turnstile_token": "{{turnstileTestToken}}"
  }
}

script:pre-request {
  const randomSuffix = Math.floor(Math.random() * 250) + 1;
  const clientIp = `198.51.100.${randomSuffix}`;
  bru.setVar("isolatedTestIp", clientIp);

  const baseUrl = bru.getEnvVar("baseUrl") || "http://localhost:8000";
  const url = `${baseUrl}/api/v1/agent/chat`;
  const token = bru.getEnvVar("turnstileTestToken") || "test_valid_turnstile_token";
  const payload = JSON.stringify({
    query: "Rate limit test warmup",
    turnstile_token: token,
  });

  const http = require("http");
  const parsedUrl = new URL(url);

  for (let i = 0; i < 5; i++) {
    const req = http.request({
      hostname: parsedUrl.hostname,
      port: parsedUrl.port || 80,
      path: parsedUrl.pathname,
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "CF-Connecting-IP": clientIp,
        "Content-Length": Buffer.byteLength(payload),
      },
    });
    req.write(payload);
    req.end();
  }
}

tests {
  test("Sixth request trips rate limit with status 429", function() {
    expect(res.getStatus()).to.equal(429);
    expect(res.getBody().retry_after_seconds).to.be.above(0);
    expect(res.getHeader("x-content-type-options")).to.equal("nosniff");
  });
}

